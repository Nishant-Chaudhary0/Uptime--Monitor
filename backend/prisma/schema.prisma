
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id Int @id @default(autoincrement())
  email String @unique
  password String
  name String?
  createdAt DateTime @default(now())
  monitor Monitor[]
}

model Monitor{
  id Int @id @default(autoincrement())
  name String
  url String
  check_intervel_minutes Int @default(5)
  createdAt DateTime @default(now())
  user_id Int
  user User @relation(fields: [user_id], references: [id])
  check Check[]
  incident Incident[]

  @@index([user_id])
}

model Check{
  id Int @id @default(autoincrement())
  monitor_id Int
  monitor Monitor @relation(fields: [monitor_id], references: [id])
  status_code Int?
  response_time_ms Int?
  is_up Boolean
  checked_at DateTime @default(now())

  @@index([monitor_id, checked_at])
}

model Incident{
  id Int @id @default(autoincrement())
  monitor_id Int
  monitor Monitor @relation(fields: [monitor_id],references: [id])
  started_at DateTime
  resolved_at DateTime?
  duration_minutes Int?
  ai_summary String?

@@index([monitor_id])
}